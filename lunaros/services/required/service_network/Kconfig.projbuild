config LUNAROS_NETWORK_ESPNOW_MANAGEMENT
    bool "Explicitly authorized ESP-NOW management sessions"
    depends on LUNAREDU_NETWORK_ENABLE_ESPNOW
    select ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1
    default y
    help
        Official PoP security1 handshake and CCM frames on the existing Network
        owner. No automatic window: native callers must specify a single peer,
        proof of possession, allowed profiles and a live authorization gate.

config ESP_WIFI_STATIC_RX_BUFFER_NUM
    int
    depends on ESP_WIFI_ENABLED || ESP_HOST_WIFI_ENABLED
    default 8 if IDF_TARGET_ESP32S31 && SPIRAM_USE_MALLOC
    default 6 if IDF_TARGET_ESP32S3 && SPIRAM_USE_MALLOC

config ESP_WIFI_STATIC_TX_BUFFER_NUM
    int
    depends on (ESP_WIFI_ENABLED || ESP_HOST_WIFI_ENABLED) && ESP_WIFI_STATIC_TX_BUFFER
    default 6 if IDF_TARGET_ESP32S31 && SPIRAM_USE_MALLOC
    default 4 if IDF_TARGET_ESP32S3 && SPIRAM_USE_MALLOC

config ESP_WIFI_RX_BA_WIN
    int
    depends on (ESP_WIFI_ENABLED || ESP_HOST_WIFI_ENABLED) && ESP_WIFI_AMPDU_RX_ENABLED
    default 8 if IDF_TARGET_ESP32S31 && SPIRAM_USE_MALLOC
    default 6 if IDF_TARGET_ESP32S3 && SPIRAM_USE_MALLOC

config ESP_WIFI_IRAM_OPT
    bool
    depends on ESP_WIFI_ENABLED || ESP_HOST_WIFI_ENABLED
    default n if SPIRAM_USE_MALLOC

config ESP_WIFI_RX_IRAM_OPT
    bool
    depends on ESP_WIFI_ENABLED || ESP_HOST_WIFI_ENABLED
    default n if SPIRAM_USE_MALLOC

choice MBEDTLS_MEM_ALLOC_MODE
    default MBEDTLS_EXTERNAL_MEM_ALLOC if SPIRAM_USE_MALLOC
endchoice

config MBEDTLS_DYNAMIC_BUFFER
    bool
    depends on !IDF_TARGET_LINUX && !MBEDTLS_SSL_PROTO_DTLS && !MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH
    default y if SPIRAM_USE_MALLOC

choice MBEDTLS_COMPILER_OPTIMIZATION
    default MBEDTLS_COMPILER_OPTIMIZATION_PERF if SPIRAM_USE_MALLOC
endchoice

config MBEDTLS_ECP_RESTARTABLE
    bool
    depends on MBEDTLS_ECP_C
    default y

config SPIRAM_TRY_ALLOCATE_WIFI_LWIP
    bool
    default y if SPIRAM_USE_MALLOC

config MQTT_BUFFERS_ON_EXTERNAL_MEMORY
    bool
    depends on SPIRAM
    default y if SPIRAM_USE_MALLOC

config MQTT_TASK_STACK_ON_EXTERNAL_MEMORY
    bool
    depends on SPIRAM && (FREERTOS_TASK_CREATE_ALLOW_EXT_MEM || SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY)
    default y if SPIRAM_USE_MALLOC

config MQTT_TASK_CORE_SELECTION_ENABLED
    bool
    default y

choice MQTT_TASK_CORE_SELECTION
    default MQTT_USE_CORE_0
endchoice

choice BT_NIMBLE_MEM_ALLOC_MODE
    default BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL if SPIRAM_USE_MALLOC
endchoice

config BT_ALLOCATION_FROM_SPIRAM_FIRST
    bool
    depends on BT_BLUEDROID_ENABLED
    default y if SPIRAM_USE_MALLOC

config BT_CTRL_ALLOW_MALLOC_FROM_SPIRAM
    bool
    depends on BT_CONTROLLER_ENABLED && IDF_TARGET_ESP32S31
    default y if SPIRAM_USE_MALLOC

config BT_BLE_DYNAMIC_ENV_MEMORY
    bool
    depends on BT_BLUEDROID_ENABLED
    default y if SPIRAM_USE_MALLOC

config BT_BLUEDROID_TASK_STACK_IN_EXT_MEM
    bool
    depends on BT_BLUEDROID_ENABLED && SPIRAM && FREERTOS_TASK_CREATE_ALLOW_EXT_MEM
    default y if SPIRAM_USE_MALLOC

config BT_BLUEDROID_BTU_TASK_STACK_IN_EXT_MEM
    bool
    depends on BT_BLUEDROID_ENABLED && SPIRAM && FREERTOS_TASK_CREATE_ALLOW_EXT_MEM
    default y if SPIRAM_USE_MALLOC

config BT_BLUEDROID_HCI_TASK_STACK_IN_EXT_MEM
    bool
    depends on BT_BLUEDROID_ENABLED && SPIRAM && FREERTOS_TASK_CREATE_ALLOW_EXT_MEM
    default y if SPIRAM_USE_MALLOC

config BT_LE_MAX_CONNECTIONS
    int
    depends on BT_CONTROLLER_ENABLED && !BT_NIMBLE_ENABLED
    default 1

config BT_LE_CONN_RESERVED_MEMORY_COUNT
    int
    depends on BT_CONTROLLER_ENABLED && !BT_NIMBLE_ENABLED
    default 1

config BT_NIMBLE_MAX_CONNECTIONS
    int
    depends on BT_NIMBLE_ENABLED
    default 2

config BT_CTRL_BLE_MAX_ACT
    int
    depends on BT_CONTROLLER_ENABLED && IDF_TARGET_ESP32S3
    default 4

config ESP_COEX_SW_COEXIST_ENABLE
    bool
    depends on (ESP_WIFI_ENABLED && BT_ENABLED) || (ESP_WIFI_ENABLED && IEEE802154_ENABLED) || (IEEE802154_ENABLED && BT_ENABLED)
    default y if BT_ENABLED

config ESP_WIFI_EXTRA_IRAM_OPT
    bool
    default n if SPIRAM_USE_MALLOC

config ESP_WIFI_SLP_IRAM_OPT
    bool
    default n if SPIRAM_USE_MALLOC

choice LWIP_TCPIP_TASK_AFFINITY
    default LWIP_TCPIP_TASK_AFFINITY_CPU0
endchoice

choice ESP_WIFI_TASK_CORE_ID
    default ESP_WIFI_TASK_PINNED_TO_CORE_0
endchoice

config LWIP_MAX_SOCKETS
    int
    default 12

# Keep ingress capacity at least as large as the opted-in 24-frame window.
# SDK UDP admission discards datagrams before application counters when full.
config LWIP_UDP_RECVMBOX_SIZE
    int
    default 24 if LUNAROS_NETWORK_REALTIME_UDP

config LWIP_TCPIP_RECVMBOX_SIZE
    int
    default 32 if LUNAROS_NETWORK_REALTIME_UDP
    default 16

config LWIP_MAX_ACTIVE_TCP
    int
    default 10

config LWIP_MAX_LISTENING_TCP
    int
    default 6

config LWIP_MAX_UDP_PCBS
    int
    default 6

config LWIP_DHCPS_MAX_STATION_NUM
    int
    default 2

config LWIP_TCP_OOSEQ_MAX_PBUFS
    int
    default 4
config MBEDTLS_HARDWARE_AES
    bool
    default n if !LUNAROS_NETWORK_HARDWARE_AES


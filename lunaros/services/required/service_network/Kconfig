menu "LunarOS service_network"

config LUNAROS_NETWORK_REALTIME_UDP
    bool "Reserve receive capacity for real-time UDP streams"
    default n
    help
        Select bounded socket and TCP/IP mailboxes for streams with up to
        24 outstanding datagrams. This does not enable a radio or open a
        socket. Applications still own their stream pacing and lifetime.

# Shared transport implementation, not a product setting or runtime toggle.
config LUNAROS_NETWORK_TLS_SESSION_SUPPORT
    bool
    default y
    depends on ESP_TLS_USING_MBEDTLS && MBEDTLS_CLIENT_SSL_SESSION_TICKETS
    select ESP_TLS_CLIENT_SESSION_TICKETS
    select ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT

config LUNAROS_NETWORK_BLUETOOTH_PROFILES
    bool "Enable Bluetooth discovery, pairing and peripheral profiles"
    default n
    help
        Optional protocol capabilities inside Network, sharing its controller,
        host, executor and lifecycle. This does not turn on the radio.
        Classic music additionally requires an explicitly selected Audio owner.


config LUNAREDU_NETWORK_ENABLE_ESPNOW
    bool "Enable LunarOS ESP-NOW transport"
    default n
    help
        Compile ESP-NOW under the shared Network service. Products opt in
        through NetworkPolicy; Wi-Fi lifecycle remains owned by LunarOS.

config LUNAROS_NETWORK_LOCAL_ACCESS
    bool "Enable temporary local Wi-Fi access"
    default y

config LUNAROS_NETWORK_LOCAL_GATT
    bool "Enable local BLE GATT transport"
    depends on BT_NIMBLE_ENABLED
    default n
    help
        Compile the local data GATT transport. Function owners supply handlers;
        this module does not own setup, account or client confirmation state.

config LUNAREDU_NETWORK_BT_START_MIN_INTERNAL_FREE
    int "Minimum free internal DMA bytes before Bluetooth startup"
    depends on BT_BLUEDROID_ENABLED || BT_NIMBLE_ENABLED
    range 0 524288
    default 65536 if SPIRAM_USE_MALLOC && BT_BLUEDROID_ENABLED
    default 49152 if SPIRAM_USE_MALLOC && BT_NIMBLE_ENABLED
    default 0
    help
        Network admission for controller pools and host tasks. Reject
        startup before calling the SDK when this budget is unavailable.

config LUNAREDU_NETWORK_BT_START_MIN_INTERNAL_BLOCK
    int "Minimum contiguous internal DMA bytes before Bluetooth startup"
    depends on BT_BLUEDROID_ENABLED || BT_NIMBLE_ENABLED
    range 0 524288
    default 32768 if SPIRAM_USE_MALLOC && BT_BLUEDROID_ENABLED
    default 30720 if SPIRAM_USE_MALLOC && BT_NIMBLE_ENABLED
    default 0

endmenu
config LUNAROS_NETWORK_HARDWARE_AES
    bool "Use SDK hardware AES acceleration"
    default y
    help
        Network owns the SDK crypto implementation selection. A product may
        disable acceleration explicitly when validating its board memory path.


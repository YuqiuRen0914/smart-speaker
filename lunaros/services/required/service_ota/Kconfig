menu "Lunaredu OTA"

config LUNAREDU_OTA_DUAL_SLOT_LAYOUT
    bool "Use explicit dual 6 MiB business slots (16 MiB v2)"
    default n
    depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32S31) && BOOTLOADER_APP_ROLLBACK_ENABLE && !LUNAREDU_OTA_RECOVERY_LAYOUT
    help
        Requires the exact lunaros-16m-v2 table and a board-matched business
        image declaration. This selects an installation policy, not a runtime
        partition migration. Existing unselected profiles keep their policy.

config LUNAREDU_OTA_RECOVERY_LAYOUT
    bool "Use permanent recovery with one business partition (16 MiB v3)"
    default n
    depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32S31) && BOOTLOADER_APP_ROLLBACK_ENABLE && !BOOTLOADER_APP_ANTI_ROLLBACK
    help
        Requires the exact lunaros-16m-v3-recovery partition layout. Only
        recovery may install a v3 business image; business must hand off first.
        Existing v2 builds retain their original writer and boot behavior.

config LUNAREDU_OTA_RECOVERY_IMAGE
    bool "This image is the permanent factory recovery application"
    depends on LUNAREDU_OTA_RECOVERY_LAYOUT
    default n

config LUNAREDU_OTA_RECOVERY_HARDWARE
    string "Compatible deployment hardware identity"
    depends on LUNAREDU_OTA_RECOVERY_LAYOUT || LUNAREDU_OTA_DUAL_SLOT_LAYOUT
    default "remote-control-controller"

config LUNAREDU_SYSTEM_OTA_BOOT_CONFIRM_TIMEOUT_MS
    int "OTA boot confirmation timeout (ms)"
    depends on BOOTLOADER_APP_ROLLBACK_ENABLE
    default 120000
    range 5000 300000
    help
        Maximum time a newly booted OTA image may remain pending verification.
        The framework boot-health gate confirms the image after critical
        tasks and recovery services are healthy. If health is not reached,
        LunarOS marks the image invalid and boots the previous image.
        The default covers the shared 60-second Wi-Fi provisioning fallback
        plus service startup and the continuous boot-health confirmation.

endmenu

config LUNAREDU_OTA_FIELD_DIAGNOSTICS_LAYOUT
    bool "Field diagnostics partition layout"
    depends on LUNAREDU_OTA_RECOVERY_LAYOUT
    default n
    help
        Selects the explicit v4 recovery/business layout with a 512 KiB encrypted Core Dump partition.

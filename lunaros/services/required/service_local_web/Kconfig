menu "Lunaredu Local Web"

config LUNAREDU_DEVICE_WEB
    bool "Device-hosted Web pages"
    default y
    help
        Compile embedded setup and product pages in the Local Web service.
        Its HTTP API remains available without pages; SoftAP/DNS belong to Network.

config LUNAREDU_DEVICE_WEB_MAX_PAGE_BYTES
    int "Maximum optional filesystem/product Web page bytes"
    range 4096 131072
    default 65536
    depends on LUNAREDU_DEVICE_WEB

config LUNAREDU_DEVICE_API_HTTP_SERVER_PORT
    int "Local Device API HTTP port"
    default 80
    range 1 65535

config LUNAREDU_DEVICE_API_HTTP_STACK_SIZE
    int "Local Device API HTTP task stack size"
    default 12288
    range 4096 65536

config LUNAREDU_DEVICE_API_HTTP_SERVER_CORE_ID
    int "Local Device API HTTP task core"
    default 0
    range 0 1
    help
        Keep blocking HTTP parsing and serialization with network I/O on
        core 0. Device access still uses each operation's declared executor;
        the HTTP task does not become the input or graphical owner.

config LUNAREDU_DEVICE_API_HTTP_MAX_BUFFERED_BODY_BYTES
    int "Local Device API max buffered body bytes"
    default 65536
    range 1024 1048576

config LUNAREDU_DEVICE_API_HTTP_BODY_RECEIVE_TIMEOUTS
    int "Local Device API body receive timeout retries"
    default 3
    range 0 255

endmenu

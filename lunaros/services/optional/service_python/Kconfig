menu "LunarEdu MicroPython"

config LUNAREDU_MICROPYTHON_HEAP_BYTES
    int "MicroPython heap size"
    default 65536
    range 16384 524288
    help
        Heap size in bytes passed to the embedded MicroPython VM.

config LUNAREDU_MICROPYTHON_MAX_UPLOAD_PAYLOAD_BYTES
    int "Maximum script upload payload"
    default 12288
    range 1024 262144
    help
        Maximum accepted script upload body size in bytes.

config LUNAREDU_MICROPYTHON_MAX_LOGS
    int "MicroPython log ring entries"
    default 64
    range 1 255
    help
        Number of stdout/runtime log entries retained in memory.

config LUNAREDU_MICROPYTHON_TICK_INTERVAL_MS
    int "MicroPython owner tick interval"
    default 10
    range 1 1000
    help
        Tick interval reported in MicroPython capability metadata.

config LUNAREDU_MICROPYTHON_TASK_STACK_BYTES
    int "MicroPython owner task stack size"
    default 12288
    range 8192 32768
    help
        Stack size in bytes for the single FreeRTOS task that owns the VM.

config LUNAREDU_MICROPYTHON_TASK_PRIORITY
    int "MicroPython owner task priority"
    default 1
    range 1 20
    help
        FreeRTOS priority for the MicroPython VM owner task.

config LUNAREDU_MICROPYTHON_COMMAND_QUEUE_DEPTH
    int "MicroPython command queue depth"
    default 8
    range 2 32
    help
        Number of pending script or REPL commands accepted by the VM task.

config LUNAREDU_MICROPYTHON_ENABLE_HARDWARE_BINDINGS
    bool "Enable LunarEdu hardware native module"
    default n
    help
        Build the optional Python-side lunaredu native module and bind it to
        LunarEdu device and system capabilities. Leave this disabled
        for firmware that only needs the base MicroPython VM.

config LUNAREDU_MICROPYTHON_ENABLE_RGB_BINDING
    bool "Expose WS2812 APIs"
    depends on LUNAREDU_MICROPYTHON_ENABLE_HARDWARE_BINDINGS
    default n

config LUNAREDU_MICROPYTHON_ENABLE_IMU_BINDING
    bool "Expose MPU6050 APIs"
    depends on LUNAREDU_MICROPYTHON_ENABLE_HARDWARE_BINDINGS
    default n

config LUNAREDU_MICROPYTHON_ENABLE_CAMERA_BINDING
    bool "Expose camera APIs"
    depends on LUNAREDU_MICROPYTHON_ENABLE_HARDWARE_BINDINGS
    default n

config LUNAREDU_MICROPYTHON_ENABLE_TFCARD_BINDING
    bool "Expose TF card APIs"
    depends on LUNAREDU_MICROPYTHON_ENABLE_HARDWARE_BINDINGS
    default n

config LUNAREDU_MICROPYTHON_ENABLE_SERVO_BINDING
    bool "Expose servo APIs"
    depends on LUNAREDU_MICROPYTHON_ENABLE_HARDWARE_BINDINGS
    default n

config LUNAREDU_MICROPYTHON_ENABLE_ASRPRO_BINDING
    bool "Expose ASRPRO APIs"
    depends on LUNAREDU_MICROPYTHON_ENABLE_HARDWARE_BINDINGS
    default n

config LUNAREDU_MICROPYTHON_ENABLE_SCREEN_BINDING
    bool "Expose SPI LCD canvas APIs"
    depends on LUNAREDU_MICROPYTHON_ENABLE_HARDWARE_BINDINGS
    default n

config LUNAREDU_MICROPYTHON_ENABLE_VISION_BINDINGS
    bool "Expose vision APIs to the LunarEdu Python module"
    select LUNAROS_IMAGE_CODEC_ENABLE_JPEG_DECODER
    select LUNAREDU_MICROPYTHON_ENABLE_CAMERA_BINDING
    depends on LUNAREDU_MICROPYTHON_ENABLE_HARDWARE_BINDINGS
    default n
    help
        Add lunaredu.vision and the JPEG decoder to the optional hardware
        facade. A camera-backed product is required. Keep this disabled on
        products without a vision workflow so
          MicroPython does not pull the recognition application and image-codec component into
        the firmware.

config LUNAREDU_MICROPYTHON_ENABLE_LUNARLINK_BINDINGS
    bool "Expose LunarLink assistant service to the LunarEdu Python module"
    depends on LUNAREDU_MICROPYTHON_ENABLE_HARDWARE_BINDINGS
    default n
    help
        Add lunaredu.lunarlink status and lifecycle controls to the optional
        hardware facade. The LunarLink service remains a native FreeRTOS service;
        Python only receives a thin application-facing adapter.

config LUNAREDU_MICROPYTHON_ENABLE_PET_BINDINGS
    bool "Expose safe smart-pet motion APIs to the LunarEdu Python module"
    depends on LUNAREDU_MICROPYTHON_ENABLE_HARDWARE_BINDINGS
    default n
    help
        Add lunaredu.robot semantic movement helpers. Commands are validated
        and executed through Motion's OS capability as caller micropython;
        Python never owns motor GPIO or PWM. This binding does not require Pet.


config LUNAROS_ENABLE_MICROPYTHON
    bool "Enable core MicroPython script execution"
    default y
    help
        Expose the shared script upload, run, stop, REPL and log API by default.
        The VM starts on demand; enabling the API does not run user code at boot.
        Disable explicitly for products that must not execute Python scripts.
        Hardware bindings remain separately selected by the product.

endmenu

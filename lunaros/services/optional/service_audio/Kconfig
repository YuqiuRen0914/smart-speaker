menu "LunarOS audio"
config LUNAROS_AUDIO_FILE_PLAYER
    bool "Managed streaming file player"
    default n
    help
        One managed decoder worker using the shared AudioFileDecoder. Supports
        native stereo PCM and service-owned background playback independently
        of the foreground display owner.
config LUNAROS_AUDIO_DUAL_I2S
    bool "Independent dual I2S TX output"
    default n
    help
        Parameterized dual-controller output, fixed PCM pool, shared DSP and
        checked drain/shutdown. Board pins and settings namespace are injected.
config LUNAROS_AUDIO_RUNTIME
    bool "Enable PCM audio runtime"
    default y if LUNAREDU_DEVICE_ENABLE_AUDIO
    default n
    help
        Build the shared PCM bridge, buffering and realtime audio runtime.
        Products using a board codec/BSP can enable this without enabling the
        generic LunarEdu I2S hardware device.

config LUNAROS_AUDIO_REFERENCE_SAMPLES
    int "Maximum output reference samples"
    range 256 64000
    default 8000
    help
        Fixed PCM reference ring capacity, allocated only when audio starts.
        Each sample consumes two bytes. 8000 samples represent 500 ms at 16 kHz.
config LUNAROS_AUDIO_REALTIME_OUTPUT_CORE
    int "Realtime PCM output worker core"
    depends on LUNAROS_AUDIO_RUNTIME && LUNAREDU_DEVICE_I2S_AUDIO
    range 0 0 if FREERTOS_UNICORE
    range 0 1
    default 0
    help
        Product execution placement for the existing managed PCM output owner.
        Choose alongside the capture, decoder, network and display task plan.
        Priority, buffering, sample rate and DSP remain independent of affinity.
endmenu

# Diagnostic transport policy belongs to Diagnostics, not individual boards.
choice HEAP_TRACING_DEST
    default HEAP_TRACING_STANDALONE if LUNAROS_DIAGNOSTIC_HEAP
endchoice
config HEAP_TRACING_STACK_DEPTH
    int
    default 4 if LUNAROS_DIAGNOSTIC_HEAP

choice ESP_TRACE_LIBRARY
    default ESP_TRACE_LIB_EXTERNAL if LUNAROS_DIAGNOSTIC_SYSTEMVIEW
    default ESP_TRACE_LIB_NONE
endchoice

choice ESP_TRACE_TRANSPORT
    default ESP_TRACE_TRANSPORT_EXTERNAL if LUNAROS_DIAGNOSTIC_SYSTEMVIEW && LUNAROS_DIAGNOSTIC_FIELD
    default ESP_TRACE_TRANSPORT_APPTRACE if LUNAROS_DIAGNOSTIC_APPTRACE || LUNAROS_DIAGNOSTIC_SYSTEMVIEW
endchoice

choice APPTRACE_DESTINATION
    default APPTRACE_DEST_JTAG if LUNAROS_DIAGNOSTIC_APPTRACE || LUNAROS_DIAGNOSTIC_SYSTEMVIEW
endchoice

choice ESP_TRACE_TIMESTAMP_SOURCE
    default ESP_TRACE_TS_SOURCE_ESP_TIMER if LUNAROS_DIAGNOSTIC_SYSTEMVIEW
endchoice

config SEGGER_SYSVIEW_MAX_TASKS
    int
    default 64 if LUNAROS_DIAGNOSTIC_SYSTEMVIEW

config SEGGER_SYSVIEW_BUF_WAIT_TMO
    int
    default 0 if LUNAROS_DIAGNOSTIC_SYSTEMVIEW

config APPTRACE_LOCK_ENABLE
    bool
    default y if LUNAROS_DIAGNOSTIC_APPTRACE || LUNAROS_DIAGNOSTIC_SYSTEMVIEW

config APPTRACE_ONPANIC_HOST_FLUSH_TMO
    int
    default 100 if LUNAROS_DIAGNOSTIC_APPTRACE || LUNAROS_DIAGNOSTIC_SYSTEMVIEW

choice ESP_COREDUMP_TO_FLASH_OR_UART
    default ESP_COREDUMP_ENABLE_TO_FLASH if LUNAROS_DIAGNOSTIC_COREDUMP_FLASH
    default ESP_COREDUMP_ENABLE_TO_UART if LUNAROS_DIAGNOSTIC_COREDUMP_UART || LUNAROS_DIAGNOSTIC_COREDUMP_FLASH
endchoice

config ESP_COREDUMP_STACK_SIZE
    int
    default 2048 if LUNAROS_DIAGNOSTIC_COREDUMP_UART || LUNAROS_DIAGNOSTIC_COREDUMP_FLASH

config ESP_COREDUMP_LOGS
    bool
    default n if LUNAROS_DIAGNOSTIC_COREDUMP_UART || LUNAROS_DIAGNOSTIC_COREDUMP_FLASH

config ESP_COREDUMP_CAPTURE_DRAM
    bool
    default n if LUNAROS_DIAGNOSTIC_COREDUMP_UART || LUNAROS_DIAGNOSTIC_COREDUMP_FLASH

# APP_RETRIEVE_LEN_ELF_SHA is assigned by the shared diagnostic profiles.
# The SDK declares its unconditional default earlier, so a later Kconfig
# default here cannot select the full identity required by Flash Core Dump.

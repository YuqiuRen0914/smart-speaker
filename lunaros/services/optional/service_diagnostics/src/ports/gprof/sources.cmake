get_filename_component(gprof_bundle "${CMAKE_CURRENT_LIST_DIR}/../../../vendor/gprof" ABSOLUTE)
include("${gprof_bundle}/sources.cmake")
target_include_directories(${COMPONENT_LIB} PRIVATE "${gprof_bundle}/upstream/include")
if(CONFIG_GPROF_ENABLE AND NOT CMAKE_BUILD_EARLY_EXPANSION AND NOT CMAKE_SCRIPT_MODE_FILE)
  find_program(GPROF_NODE node REQUIRED)
  set(gprof_port "${CMAKE_CURRENT_BINARY_DIR}/official_gprof")
  execute_process(COMMAND "${GPROF_NODE}" "${CMAKE_CURRENT_LIST_DIR}/materialize-port.mjs" "${gprof_port}" "${gprof_bundle}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Diagnostics GProf port materialization failed")
  endif()
  idf_build_set_property(LUNAROS_GPROF_BUILD_SCRIPT "${gprof_port}/gprof.cmake")
  # The owner is profiled with -pg. Keep its collector/hooks in a separate
  # private archive so _mcount cannot instrument itself or recurse on entry.
  set(diagnostic_gprof_port "${COMPONENT_LIB}__gprof_port")
  add_library(${diagnostic_gprof_port} STATIC)
  target_sources(${diagnostic_gprof_port} PRIVATE "${gprof_port}/esp_gprof.c" "${CMAKE_CURRENT_LIST_DIR}/owner-port.c")
  target_include_directories(${diagnostic_gprof_port} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/include" "${gprof_bundle}/upstream/private_include" "${gprof_bundle}/upstream/include")
  target_compile_definitions(${diagnostic_gprof_port} PRIVATE GPROF_VER_MAJOR=0 GPROF_VER_MINOR=2 GPROF_VER_PATCH=1)
  target_link_libraries(${diagnostic_gprof_port} PRIVATE idf::esp_partition idf::freertos idf::heap idf::log idf::lwip idf::esp_timer idf::esp_system idf::esp_hw_support)
  target_link_libraries(${COMPONENT_LIB} PRIVATE ${diagnostic_gprof_port})
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${gprof_bundle}/UPSTREAM.json" "${CMAKE_CURRENT_LIST_DIR}/materialize-port.mjs")
endif()

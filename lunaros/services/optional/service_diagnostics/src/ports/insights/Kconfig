config LUNAROS_DIAGNOSTIC_INSIGHTS
    bool "ESP Insights metrics through LunarLink"
    depends on LUNAROS_DIAGNOSTIC_FIELD
    default y

config DIAG_ENABLE_METRICS
    bool
    default y if LUNAROS_DIAGNOSTIC_INSIGHTS

config DIAG_METRICS_MAX_COUNT
    int
    default 8

config DIAG_DATA_STORE_RAM
    bool
    default y if LUNAROS_DIAGNOSTIC_INSIGHTS

config RAM_STORE_DATA_SIZE
    int
    default 2048

config RAM_STORE_CRITICAL_DATA_SIZE
    int
    default 512

config DIAG_DATA_STORE_REPORTING_WATERMARK_PERCENT
    int
    default 80

config DIAG_LOG_MSG_ARG_FORMAT_STRING
    bool
    default y if LUNAROS_DIAGNOSTIC_INSIGHTS

config DIAG_LOG_MSG_ARG_MAX_SIZE
    int
    default 64

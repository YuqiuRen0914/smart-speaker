get_filename_component(insights_bundle "${CMAKE_CURRENT_LIST_DIR}/../../../vendor/esp_insights" ABSOLUTE)
include("${insights_bundle}/sources.cmake")
target_include_directories(${COMPONENT_LIB} PRIVATE ${insights_vendor_includes})
if(CONFIG_LUNAROS_DIAGNOSTIC_INSIGHTS AND NOT CMAKE_BUILD_EARLY_EXPANSION AND NOT CMAKE_SCRIPT_MODE_FILE)
  find_program(INSIGHTS_STORE_NODE node REQUIRED)
  set(insights_store "${CMAKE_CURRENT_BINARY_DIR}/insights_store")
  execute_process(COMMAND "${INSIGHTS_STORE_NODE}" "${CMAKE_CURRENT_LIST_DIR}/materialize-store.mjs" "${insights_store}" "${insights_bundle}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Diagnostics RAM-only Insights store materialization failed")
  endif()
  # Keep encoder, metrics and store in one private uninstrumented archive.
  # There is no independent IDF identity or public include export.
  set(diagnostic_insights_port "${COMPONENT_LIB}__insights_port")
  add_library(${diagnostic_insights_port} STATIC)
  target_sources(${diagnostic_insights_port} PRIVATE ${insights_vendor_sources} "${insights_store}/rtc_store.c")
  target_include_directories(${diagnostic_insights_port} PRIVATE ${insights_vendor_includes})
  target_link_libraries(${diagnostic_insights_port} PRIVATE idf::espressif__cbor idf::esp_event idf::freertos idf::esp_system idf::esp_timer idf::esp_hw_support idf::esp_partition idf::app_update idf::esp_app_format idf::log idf::esp_rom)
  target_link_libraries(${COMPONENT_LIB} PRIVATE ${diagnostic_insights_port})
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${insights_bundle}/UPSTREAM.json" "${CMAKE_CURRENT_LIST_DIR}/materialize-store.mjs" "${insights_bundle}/materialize-port.mjs")
endif()

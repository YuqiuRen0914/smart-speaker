#pragma once
#ifndef __ASSEMBLER__
// SEGGER's documented Global.h integration: retain its exact scalar types while
// replacing short-name macros with typedefs. FreeRTOS trace hooks expose these
// names to every SDK consumer; macros would corrupt SettingsValueType::U8 etc.
// The managed component and installed SDK remain unchanged.
#include "@SYSVIEW_GLOBAL_HEADER@"
typedef U8 lunaros_sysview_u8;
typedef I8 lunaros_sysview_i8;
typedef U16 lunaros_sysview_u16;
typedef I16 lunaros_sysview_i16;
typedef U32 lunaros_sysview_u32;
typedef I32 lunaros_sysview_i32;
typedef U64 lunaros_sysview_u64;
typedef I64 lunaros_sysview_i64;
#undef U8
#undef I8
#undef U16
#undef I16
#undef U32
#undef I32
#undef U64
#undef I64
typedef lunaros_sysview_u8 U8;
typedef lunaros_sysview_i8 I8;
typedef lunaros_sysview_u16 U16;
typedef lunaros_sysview_i16 I16;
typedef lunaros_sysview_u32 U32;
typedef lunaros_sysview_i32 I32;
typedef lunaros_sysview_u64 U64;
typedef lunaros_sysview_i64 I64;
#endif

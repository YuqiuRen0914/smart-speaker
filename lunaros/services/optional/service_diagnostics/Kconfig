rsource "src/ports/gprof/Kconfig"
rsource "src/ports/insights/Kconfig"

menu "LunarOS diagnostics capture"
config LUNAROS_DIAGNOSTIC_FIELD
    bool "Private diagnostic outbox and authenticated Platform upload"
    depends on LUNAREDU_SYSTEM_DIAGNOSTICS
    default n
    help
        Stores up to six bounded records in Storage's private namespace.
        Upload requires explicit consent for the current Platform binding.
config LUNAROS_DIAGNOSTIC_HEAP
    bool "Official bounded standalone heap tracing"
    depends on LUNAREDU_SYSTEM_DIAGNOSTICS
    default n
    help
        Allocates 256 internal trace records on explicit authorized start.
        Session expiry stops tracing; service shutdown detaches and frees them.
choice LUNAROS_DIAGNOSTIC_INSIGHTS_PROFILE
    prompt "Insights bounded metric set"
    depends on LUNAROS_DIAGNOSTIC_INSIGHTS
    default LUNAROS_DIAGNOSTIC_INSIGHTS_SYSTEM
config LUNAROS_DIAGNOSTIC_INSIGHTS_SYSTEM
    bool "Memory, tasks and optional PCM anomalies"
config LUNAROS_DIAGNOSTIC_INSIGHTS_IO
    bool "Network queue, execution and completion counters"
    help
        Selects eight existing allocation-free Network counters. Does not
        increase the metric store, sampling frequency or worker count.
endchoice
choice LUNAROS_DIAGNOSTIC_TRACE
    prompt "Official trace integration"
    default LUNAROS_DIAGNOSTIC_TRACE_NONE
config LUNAROS_DIAGNOSTIC_TRACE_NONE
    bool "Disabled"
config LUNAROS_DIAGNOSTIC_APPTRACE
    bool "App Trace operation records (JTAG and optional field retention)"
    depends on LUNAREDU_SYSTEM_DIAGNOSTICS && !PM_ENABLE
config LUNAROS_DIAGNOSTIC_SYSTEMVIEW
    bool "SystemView scheduler and operation events (JTAG or field retention)"
    depends on LUNAREDU_SYSTEM_DIAGNOSTICS && !PM_ENABLE
endchoice
config LUNAROS_DIAGNOSTIC_COREDUMP_UART
    bool "ELF core dump on the existing panic console"
    depends on LUNAREDU_SYSTEM_DIAGNOSTICS
    default n
    help
        Does not change partitions or select a rescue image. SDK panic capture
        is independent of the optional service lifecycle. Keep the matching ELF
        and capture the console with IDF Monitor. External RAM is not included.
config LUNAREDU_SYSTEM_DIAGNOSTICS
    bool "System diagnostic operations and sessions"
    default n
config LUNAREDU_LOCAL_DEBUG_SURFACE
    bool "Local log and display debugging"
    default n
config LUNAROS_DIAGNOSTIC_LOG_RECORDS
    int "Retained log/trace records"
    range 16 256
    default 64
config LUNAROS_DIAGNOSTIC_LOG_MESSAGE_BYTES
    int "Bytes per captured log message"
    range 160 512
    default 160
endmenu

config LUNAROS_DIAGNOSTIC_COREDUMP_FLASH
    bool
    depends on LUNAREDU_OTA_FIELD_DIAGNOSTICS_LAYOUT && LUNAROS_DIAGNOSTIC_FIELD
    default y

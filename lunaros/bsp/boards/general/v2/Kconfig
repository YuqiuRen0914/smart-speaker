menu "Experimental general board: hardware v2"
config LUNAROS_BSP_V2_ENABLED
    bool "Enable unmanufactured general board v2 (plan 2)"
    depends on IDF_TARGET_ESP32S3 && LUNAREDU_BSP_PROFILE_NONE
    default n
    help
        在统一bsp组件内启用通用板v2候选后端，仅用于契约验证。
        必须选择未指定现役板级资源，不能同时启用旧板型owner。
        当前接线为候选，未正式打板、烧录或真机验收。

if LUNAROS_BSP_V2_ENABLED
choice LUNAROS_BSP_V2_DISPLAY
    prompt "v2 display assembly"
    default LUNAROS_BSP_V2_DISPLAY_LCD
config LUNAROS_BSP_V2_DISPLAY_NONE
    bool "No display"
config LUNAROS_BSP_V2_DISPLAY_LCD
    bool "SPI LCD"
config LUNAROS_BSP_V2_DISPLAY_QSPI
    bool "QSPI AMOLED"
endchoice

config LUNAROS_BSP_V2_CAMERA
    bool "Declare candidate camera wiring (shares A/B/C)"
    default n
    help
        不启动采集；实际模组、位序、I/O电平与XCLK仍需产品确认。
config LUNAROS_BSP_V2_TFCARD
    bool "Declare shared SPI TF card (CS42)"
    default n
    help
        卡存在时先初始化进SPI模式，再通信屏幕。不承诺热插拔。
config LUNAROS_BSP_V2_I2C_CLOCK_HZ
    int "Common I2C candidate clock (U2 protocol unconfirmed)"
    range 100000 400000
    default 400000
config LUNAROS_BSP_V2_INTERFACE_I2C_CLOCK_HZ
    int "Expansion I2C clock"
    range 100000 400000
    default 400000
endif
endmenu

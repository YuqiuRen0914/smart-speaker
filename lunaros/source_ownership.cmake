# Explicit ownership; discovery only rejects unassigned implementations.
cmake_policy(SET CMP0057 NEW)
set(lunaros_source_manifest "${CMAKE_CURRENT_LIST_DIR}/source_ownership.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lunaros_source_manifest}")
file(READ "${lunaros_source_manifest}" lunaros_source_ownership)
string(JSON lunaros_owner_count LENGTH "${lunaros_source_ownership}")
if(NOT lunaros_owner_count EQUAL 12)
    message(FATAL_ERROR "Expected only core, runtime, composition, graphics, desktop, display display_graphics, application, configuration device_api and device_api_application and device_api_configuration owners")
endif()
set(lunaros_owned_sources "")
foreach(group core runtime composition graphics desktop display display_graphics application configuration device_api device_api_application device_api_configuration)
    if(group STREQUAL "device_api_application")
        set(owner_prefix "os/application/adapters/device_api_application/src/")
    elseif(group STREQUAL "device_api_configuration")
        set(owner_prefix "os/configuration/adapters/device_api_configuration/src/")
    elseif(group STREQUAL "composition")
        set(owner_prefix "os/desktop/src/composition/")
    elseif(group STREQUAL "graphics")
        set(owner_prefix "os/desktop/src/graphics/")
    elseif(group STREQUAL "display_graphics")
        set(owner_prefix "os/display/src/graphics/")
    elseif(group STREQUAL "display")
        set(owner_prefix "os/display/src/")
    else()
        set(owner_prefix "os/${group}/src/")
    endif()
    set(group_sources "")
    string(JSON group_count LENGTH "${lunaros_source_ownership}" "${group}")
    if(group_count GREATER 0)
        math(EXPR group_last "${group_count} - 1")
        foreach(index RANGE 0 ${group_last})
            string(JSON source GET "${lunaros_source_ownership}" "${group}" ${index})
            string(FIND "${source}" "${owner_prefix}" prefix_position)
            if(group STREQUAL "display" AND NOT source MATCHES "^os/display/src/(screen|pipeline|graphics/raster|adapters)/")
                message(FATAL_ERROR "Invalid mandatory Display source: ${source}")
            endif()
            string(SUBSTRING "${source}" 0 3 source_start)
            if(source_start STREQUAL "../")
                string(SUBSTRING "${source}" 3 -1 checked_source)
            else()
                set(checked_source "${source}")
            endif()
            if(group STREQUAL "graphics" AND source MATCHES "^os/desktop/src/ui/")
                set(prefix_position 0)
            endif()
            if(NOT prefix_position EQUAL 0 OR NOT source MATCHES ".+\\.cpp$" OR checked_source MATCHES "(^|/)\\.\\.?(/|$)" OR checked_source MATCHES "//")
                message(FATAL_ERROR "Invalid OS source in ${group}: ${source}")
            endif()
            get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/${source}" ABSOLUTE)
            if(NOT EXISTS "${source}")
                message(FATAL_ERROR "Missing OS source: ${source}")
            endif()
            if(source IN_LIST lunaros_owned_sources)
                message(FATAL_ERROR "OS source has multiple owners: ${source}")
            endif()
            list(APPEND group_sources "${source}")
            list(APPEND lunaros_owned_sources "${source}")
        endforeach()
    endif()
    set(lunaros_${group}_sources ${group_sources})
endforeach()
foreach(retired_directory os/application/src/app os/application/src/persistence/application os/configuration/src/configuration os/device_api/src/device_api os/device_api/test/device_api os/device_api/adapters os/device_api/include/device_api/execution os/device_context os/device_projections os/runtime/include/bootstrap os/runtime/include/lunaros os/runtime/src/bootstrap os/display/src/display core runtime display desktop include src desktop/composition os/desktop/src/desktop runtime/application_runtime os/default_desktop os/include os/src os/test lunaros_core lunaros_runtime lunaros_desktop)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/${retired_directory}")
        message(FATAL_ERROR "Retired ${retired_directory} directory; use independent packages under lunaros/")
    endif()
endforeach()
set(lunaros_source_globs
    "${CMAKE_CURRENT_LIST_DIR}/os/display/src/*.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/os/core/src/*.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/os/runtime/src/*.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/os/desktop/src/*.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/os/application/src/*.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/os/configuration/src/*.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/os/device_api/src/*.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/os/application/adapters/*/src/*.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/os/configuration/adapters/*/src/*.cpp")
if(CMAKE_SCRIPT_MODE_FILE)
    file(GLOB_RECURSE lunaros_discovered_sources ${lunaros_source_globs})
else()
    file(GLOB_RECURSE lunaros_discovered_sources CONFIGURE_DEPENDS ${lunaros_source_globs})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lunaros_source_manifest}")
endif()
foreach(source IN LISTS lunaros_discovered_sources)
    get_filename_component(source "${source}" ABSOLUTE)
    if(NOT source IN_LIST lunaros_owned_sources)
        message(FATAL_ERROR "OS source has no owner in source_ownership.json: ${source}")
    endif()
endforeach()
set(lunaros_base_composition_sources ${lunaros_composition_sources})
set(lunar_graphics_sources ${lunaros_graphics_sources})
set(lunar_desktop_sources ${lunaros_desktop_sources})

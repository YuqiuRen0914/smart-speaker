menu "Smart Speaker"

config LUNAREDU_SMART_SPEAKER_WIFI_PROVISION_TIMEOUT_MS
    int "Wi-Fi provision timeout in ms"
    range 1000 60000
    default 5000

config LUNAREDU_SMART_SPEAKER_NETWORK_TASK_STACK_SIZE
    int "Network task stack size in bytes"
    range 4096 32768
    default 12288

config LUNAREDU_SMART_SPEAKER_PLAYER_TASK_STACK_SIZE
    int "Player task stack size in bytes"
    range 4096 32768
    default 12288

config LUNAREDU_SMART_SPEAKER_ENCODER_A_GPIO
    int "Rotary encoder A GPIO"
    range 0 48
    default 12

config LUNAREDU_SMART_SPEAKER_ENCODER_B_GPIO
    int "Rotary encoder B GPIO"
    range 0 48
    default 11

config LUNAREDU_SMART_SPEAKER_ENCODER_REVERSED
    bool "Reverse encoder direction"
    default y

config LUNAREDU_SMART_SPEAKER_LEFT_BUTTON_GPIO
    int "Previous/left button GPIO"
    range 0 48
    default 8

config LUNAREDU_SMART_SPEAKER_RIGHT_BUTTON_GPIO
    int "Next/right button GPIO"
    range 0 48
    default 7

config LUNAREDU_SMART_SPEAKER_BUTTON_ACTIVE_LOW
    bool "Buttons are active low"
    default y

config LUNAREDU_SMART_SPEAKER_LEFT_I2S_WS
    int "Left MAX98357 WS GPIO"
    range 0 48
    default 6

config LUNAREDU_SMART_SPEAKER_LEFT_I2S_BCLK
    int "Left MAX98357 BCLK GPIO"
    range 0 48
    default 7

config LUNAREDU_SMART_SPEAKER_LEFT_I2S_DOUT
    int "Left MAX98357 DIN GPIO"
    range 0 48
    default 16

config LUNAREDU_SMART_SPEAKER_RIGHT_I2S_WS
    int "Right MAX98357 WS GPIO"
    range 0 48
    default 8

config LUNAREDU_SMART_SPEAKER_RIGHT_I2S_BCLK
    int "Right MAX98357 BCLK GPIO"
    range 0 48
    default 10

config LUNAREDU_SMART_SPEAKER_RIGHT_I2S_DOUT
    int "Right MAX98357 DIN GPIO"
    range 0 48
    default 5

config LUNAREDU_SMART_SPEAKER_TOUCH_SDA_GPIO
    int "Touch controller SDA GPIO"
    range 0 48
    default 43

config LUNAREDU_SMART_SPEAKER_TOUCH_SCL_GPIO
    int "Touch controller SCL GPIO"
    range 0 48
    default 44

config LUNAREDU_SMART_SPEAKER_TOUCH_INT_GPIO
    int "Touch controller INT GPIO"
    range -1 48
    default 48

config LUNAREDU_SMART_SPEAKER_MPU6050_SDA_GPIO
    int "MPU6050 SDA GPIO"
    range 0 48
    default 41

config LUNAREDU_SMART_SPEAKER_MPU6050_SCL_GPIO
    int "MPU6050 SCL GPIO"
    range 0 48
    default 42

config LUNAREDU_SMART_SPEAKER_VOLUME_STEP
    int "Volume step per encoder detent"
    range 1 20
    default 5

config LUNAREDU_SMART_SPEAKER_FADE_MS
    int "Pop-suppression fade time in ms"
    range 20 80
    default 40

config LUNAREDU_SMART_SPEAKER_MAX_VOLUME
    int "Maximum output volume percent"
    range 1 70
    default 70

config LUNAREDU_SMART_SPEAKER_STARTUP_VOLUME
    int "Safe startup volume percent"
    range 0 20
    default 10
    help
        Volume selected after every reset. Keep this deliberately below the
        normal maximum so a marginal amplifier supply cannot enter a
        reset/playback loop before the user can intervene.

config LUNAREDU_SMART_SPEAKER_AUTOPLAY_ON_BOOT
    bool "Automatically start SD playback after boot"
    default n
    help
        Disabled by default for amplifier bring-up safety. I2S clocks remain
        active with zero samples and playback starts only after an explicit
        local or web play command.

config LUNAREDU_SMART_SPEAKER_DEVELOPMENT_PLATFORM
    bool "Use local platform for development"
    default n
    help
        Explicit development build: persist the development environment and
        restart once before using the local platform. Leave disabled for releases.

config LUNAREDU_SMART_SPEAKER_DEVELOPMENT_PLATFORM_URL
    string "Local Tools platform base URL"
    depends on LUNAREDU_SMART_SPEAKER_DEVELOPMENT_PLATFORM
    default ""
    help
        Use the Tools domain of the developer gateway on a reachable private IP.

endmenu

CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_LUNAREDU_SYSTEM_DIAGNOSTICS=y
CONFIG_LUNAREDU_LOCAL_DEBUG_SURFACE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_MBEDTLS_HARDWARE_AES is not set

CONFIG_LUNAREDU_BSP_PROFILE_CAM_BUNDLE=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y


CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y




# Build the generic helpers used by this product app. Camera stays disabled
# even though the cam-bundle BSP profile is selected for the TF-card pins.
# CONFIG_LUNAROS_AUDIO_RUNTIME is not set
CONFIG_LUNAREDU_DEVICE_ENABLE_TFCARD=y

CONFIG_LUNAREDU_SMART_SPEAKER_WIFI_PROVISION_TIMEOUT_MS=5000
CONFIG_LUNAREDU_SMART_SPEAKER_ENCODER_A_GPIO=12
CONFIG_LUNAREDU_SMART_SPEAKER_ENCODER_B_GPIO=11
CONFIG_LUNAREDU_SMART_SPEAKER_ENCODER_REVERSED=y
CONFIG_LUNAREDU_SMART_SPEAKER_LEFT_BUTTON_GPIO=8
CONFIG_LUNAREDU_SMART_SPEAKER_RIGHT_BUTTON_GPIO=7
CONFIG_LUNAREDU_SMART_SPEAKER_BUTTON_ACTIVE_LOW=y
CONFIG_LUNAREDU_SMART_SPEAKER_LEFT_I2S_WS=14
CONFIG_LUNAREDU_SMART_SPEAKER_LEFT_I2S_BCLK=47
CONFIG_LUNAREDU_SMART_SPEAKER_LEFT_I2S_DOUT=1
CONFIG_LUNAREDU_SMART_SPEAKER_RIGHT_I2S_WS=17
CONFIG_LUNAREDU_SMART_SPEAKER_RIGHT_I2S_BCLK=16
CONFIG_LUNAREDU_SMART_SPEAKER_RIGHT_I2S_DOUT=15
CONFIG_LUNAREDU_SMART_SPEAKER_VOLUME_STEP=5
CONFIG_LUNAREDU_SMART_SPEAKER_FADE_MS=40
CONFIG_LUNAREDU_SMART_SPEAKER_MAX_VOLUME=70
CONFIG_LUNAREDU_SMART_SPEAKER_STARTUP_VOLUME=10
# CONFIG_LUNAREDU_SMART_SPEAKER_AUTOPLAY_ON_BOOT is not set

CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD=y
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_ST7789=y
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_SPI2_HOST=y
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_SPI3_HOST is not set
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_MOSI=45
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_SCLK=3
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_MISO=-1
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_CS=0
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_DC=46
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_RESET=-1
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_BACKLIGHT=-1
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_PIXEL_CLOCK_HZ=40000000
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_SPI_MODE=0
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_WIDTH=240
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_HEIGHT=240
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_OFFSET_X=0
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_OFFSET_Y=0
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_MIRROR_X is not set
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_MIRROR_Y is not set
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_SWAP_XY is not set
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_INVERT_COLOR=y
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_RGB_ORDER_RGB=y
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_RGB_ORDER_BGR is not set
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_CLAIM_BSP_SPI is not set
# Chinese UI uses the shared Lunar Sans SC TTF asset through the native rasterizer.

CONFIG_LUNAREDU_DEVICE_ENABLE_MPU6050=y

CONFIG_LUNAREDU_SYSTEM_OTA_BOOT_CONFIRM_TIMEOUT_MS=120000


# Shared LunarOS 16 MiB flash contract.

# Universal 16 MiB hardware and recoverable delivery contract.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/lunaros-16m-v2.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/lunaros-16m-v2.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_LUNAROS_NETWORK_LOCAL_ACCESS=y
CONFIG_LUNAREDU_DEVICE_WEB=y

# Existing wiring snapshot; not a template for new hardware.
# The product plays local library files; downloads are owned by LunarOS.
# Keep the player's optional URL-streaming feature disabled.
CONFIG_LUNAROS_BSP_ENABLE_LEGACY_BASEBOARD=y
CONFIG_LUNAROS_BOARD_ID="lunaredu_s3_n16r8cam_baseboard"
CONFIG_LUNAROS_BOARD_NAME="LunarEdu ESP32-S3-N16R8-CAM Expansion Baseboard"
CONFIG_LUNAROS_BOARD_TYPE="lunaredu-hardware"
CONFIG_LUNAROS_BOARD_MODEL="esp32-s3-n16r8cam-baseboard"
CONFIG_LUNAROS_BOARD_REVISION="unknown"

# Dedicated stereo backend; no microphone, Assistant or speech models.
CONFIG_LUNAROS_MUSIC_EXTERNAL_PLAYER=y

CONFIG_LUNAROS_AUDIO_FILE_PLAYER=y
CONFIG_LUNAROS_AUDIO_DUAL_I2S=y

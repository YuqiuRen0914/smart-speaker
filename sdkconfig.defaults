CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

CONFIG_LUNAREDU_BSP_PROFILE_CAM_BUNDLE=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y


CONFIG_SPIRAM=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Keep DMA-capable SRAM available for SDMMC bounce buffers while Wi-Fi, LCD,
# and both I2S controllers are active. MP3 refills can be unaligned, so the
# SDMMC driver must always be able to allocate at least one temporary sector.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_MQTT_BUFFERS_ON_EXTERNAL_MEMORY=y
CONFIG_MQTT_TASK_STACK_ON_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_HZ=1000
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1000
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y


CONFIG_LITTLEFS_OBJ_NAME_LEN=64
CONFIG_LITTLEFS_READ_SIZE=128
CONFIG_LITTLEFS_WRITE_SIZE=128
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_CACHE_SIZE=512
CONFIG_LITTLEFS_USE_MTIME=y

CONFIG_AUDIO_PLAYER_ENABLE_MP3=y
# CONFIG_AUDIO_PLAYER_ENABLE_WAV is not set
CONFIG_AUDIO_PLAYER_LOG_LEVEL=1

# Build the generic helpers used by this product app. Camera stays disabled
# even though the cam-bundle BSP profile is selected for the TF-card pins.
CONFIG_LUNAREDU_DEVICE_ENABLE_AUDIO=y
CONFIG_LUNAREDU_DEVICE_ENABLE_TFCARD=y
CONFIG_LUNAREDU_DEVICE_I2S_AUDIO=y
# CONFIG_LUNAREDU_DEVICE_I2S_AUDIO_DUPLEX is not set
CONFIG_LUNAREDU_DEVICE_I2S_AUDIO_SIMPLEX=y
CONFIG_LUNAREDU_DEVICE_I2S_AUDIO_OUTPUT_SAMPLE_RATE=44100
CONFIG_LUNAREDU_DEVICE_I2S_AUDIO_INPUT_SAMPLE_RATE=44100
CONFIG_LUNAREDU_DEVICE_I2S_AUDIO_SPK_BCLK=47
CONFIG_LUNAREDU_DEVICE_I2S_AUDIO_SPK_WS=14
CONFIG_LUNAREDU_DEVICE_I2S_AUDIO_SPK_DOUT=1
CONFIG_LUNAREDU_DEVICE_I2S_AUDIO_MIC_SCK=47
CONFIG_LUNAREDU_DEVICE_I2S_AUDIO_MIC_WS=14
CONFIG_LUNAREDU_DEVICE_I2S_AUDIO_MIC_DIN=21
CONFIG_LUNAREDU_DEVICE_INPUT_PRIMARY_BUTTON=y
CONFIG_LUNAREDU_DEVICE_INPUT_PRIMARY_BUTTON_GPIO=8
CONFIG_LUNAREDU_DEVICE_INPUT_PRIMARY_BUTTON_ACTIVE_HIGH=n
CONFIG_LUNAREDU_DEVICE_INPUT_PRIMARY_BUTTON_LONG_PRESS_MS=2000
CONFIG_LUNAREDU_DEVICE_INPUT_PRIMARY_BUTTON_SHORT_PRESS_MS=0
CONFIG_LUNAREDU_DEVICE_INPUT_PTT_BUTTON=y
CONFIG_LUNAREDU_DEVICE_INPUT_PTT_BUTTON_GPIO=7
CONFIG_LUNAREDU_DEVICE_INPUT_PTT_BUTTON_ACTIVE_HIGH=n

CONFIG_LUNAREDU_SMART_SPEAKER_WIFI_PROVISION_TIMEOUT_MS=5000
CONFIG_LUNAREDU_SMART_SPEAKER_NETWORK_TASK_STACK_SIZE=12288
CONFIG_LUNAREDU_SMART_SPEAKER_PLAYER_TASK_STACK_SIZE=12288
CONFIG_LUNAREDU_SMART_SPEAKER_ENCODER_A_GPIO=12
CONFIG_LUNAREDU_SMART_SPEAKER_ENCODER_B_GPIO=11
CONFIG_LUNAREDU_SMART_SPEAKER_ENCODER_REVERSED=y
CONFIG_LUNAREDU_SMART_SPEAKER_LEFT_BUTTON_GPIO=8
CONFIG_LUNAREDU_SMART_SPEAKER_RIGHT_BUTTON_GPIO=7
CONFIG_LUNAREDU_SMART_SPEAKER_BUTTON_ACTIVE_LOW=y
CONFIG_LUNAREDU_SMART_SPEAKER_LEFT_I2S_WS=14
CONFIG_LUNAREDU_SMART_SPEAKER_LEFT_I2S_BCLK=47
CONFIG_LUNAREDU_SMART_SPEAKER_LEFT_I2S_DOUT=1
CONFIG_LUNAREDU_SMART_SPEAKER_MIC_I2S_DIN=21
CONFIG_LUNAREDU_SMART_SPEAKER_RIGHT_I2S_WS=17
CONFIG_LUNAREDU_SMART_SPEAKER_RIGHT_I2S_BCLK=16
CONFIG_LUNAREDU_SMART_SPEAKER_RIGHT_I2S_DOUT=15
CONFIG_LUNAREDU_SMART_SPEAKER_VOLUME_STEP=5
CONFIG_LUNAREDU_SMART_SPEAKER_FADE_MS=40
CONFIG_LUNAREDU_SMART_SPEAKER_MAX_VOLUME=70
CONFIG_LUNAREDU_SMART_SPEAKER_STARTUP_VOLUME=10
# CONFIG_LUNAREDU_SMART_SPEAKER_AUTOPLAY_ON_BOOT is not set

CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD=y
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_ST7789=y
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_SPI2_HOST=y
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_SPI3_HOST is not set
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_MOSI=45
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_SCLK=3
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_MISO=-1
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_CS=0
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_DC=46
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_RESET=-1
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_BACKLIGHT=-1
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_PIXEL_CLOCK_HZ=40000000
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_SPI_MODE=0
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_WIDTH=240
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_HEIGHT=240
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_OFFSET_X=0
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_OFFSET_Y=0
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_MIRROR_X is not set
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_MIRROR_Y is not set
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_SWAP_XY is not set
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_INVERT_COLOR=y
CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_RGB_ORDER_RGB=y
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_RGB_ORDER_BGR is not set
# CONFIG_LUNAREDU_DEVICE_DISPLAY_SPI_LCD_CLAIM_BSP_SPI is not set
CONFIG_LUNAREDU_DESKTOP_LVGL_RUNTIME=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LUNAREDU_DESKTOP_SHARED_FONTS=y
# Chinese UI uses the shared Lunar Sans SC TTF asset through TinyTTF.
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK is not set

CONFIG_LUNAREDU_DEVICE_ENABLE_MPU6050=y

CONFIG_LUNAREDU_SYSTEM_OTA_BOOT_CONFIRM_TIMEOUT_MS=120000
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LUNAREDU_LUNAROS_MAX_INTERNAL_TASK_STACK_BYTES=98304
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# CONFIG_MBEDTLS_HARDWARE_AES is not set

CONFIG_LV_USE_TINY_TTF=y

CONFIG_LV_MEM_SIZE_KILOBYTES=256

# Read-only CPU idle/task counters for performance diagnosis; no extra task.
# Optimize shared LCD/LVGL/network code as well as the product's hot loops.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# Shared LunarOS 16 MiB flash contract.

# Universal 16 MiB hardware and recoverable delivery contract.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/lunaros-16m-v2.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/lunaros-16m-v2.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_LUNAREDU_NETWORK_ENABLE_PROVISIONING_SERVICE=y
CONFIG_LUNAREDU_DEVICE_WEB=y

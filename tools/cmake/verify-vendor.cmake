# Caller supplies vendor_directory, vendor_manifest, vendor_manifest_hash.
# Hash bytes and compare the entire file set. No network or cache fallback.
if(NOT EXISTS "${vendor_manifest}")
  message(FATAL_ERROR "Missing vendor checksum manifest: ${vendor_manifest}")
endif()
file(SHA256 "${vendor_manifest}" actual_manifest_hash)
if(NOT actual_manifest_hash STREQUAL vendor_manifest_hash)
  message(FATAL_ERROR "Unexpected vendor checksum manifest: ${vendor_manifest}")
endif()
file(STRINGS "${vendor_manifest}" vendor_entries)
set(vendor_expected "")
foreach(entry IN LISTS vendor_entries)
  string(SUBSTRING "${entry}" 0 64 expected_hash)
  string(SUBSTRING "${entry}" 66 -1 local_path)
  if(local_path MATCHES "(^/|\\\\|(^|/)\\.\\.(/|$))")
    message(FATAL_ERROR "Invalid vendor manifest path: ${local_path}")
  endif()
  set(source_file "${vendor_directory}/${local_path}")
  if(NOT EXISTS "${source_file}" OR IS_SYMLINK "${source_file}")
    message(FATAL_ERROR "Missing or linked vendor file: ${local_path}")
  endif()
  file(SHA256 "${source_file}" actual_hash)
  if(NOT actual_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Modified vendor file: ${local_path}")
  endif()
  list(APPEND vendor_expected "${local_path}")
endforeach()
file(GLOB_RECURSE vendor_actual RELATIVE "${vendor_directory}" "${vendor_directory}/*")
list(SORT vendor_actual)
if(NOT vendor_actual STREQUAL vendor_expected)
  message(FATAL_ERROR "Unexpected file in vendor tree: ${vendor_directory}")
endif()

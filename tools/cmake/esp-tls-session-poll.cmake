# ESP-IDF applies mbedtls_ssl_set_session on every async handshake poll.
# MbedTLS rejects a second application after handshake state has advanced.
# Apply the saved session once, at initial state, using a checked build-local
# overlay. The installed SDK and certificate verification stay unchanged.
function(lunaros_fix_esp_tls_session_poll)
  if(NOT CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS OR NOT CONFIG_ESP_TLS_USING_MBEDTLS)
    return()
  endif()
  idf_component_get_property(tls_library esp-tls COMPONENT_LIB)
  get_target_property(tls_sources ${tls_library} SOURCES)
  get_target_property(tls_directory ${tls_library} SOURCE_DIR)
  set(replacement_sources)
  set(replaced 0)
  foreach(source IN LISTS tls_sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "esp_tls_mbedtls.c")
      get_filename_component(original "${source}" ABSOLUTE BASE_DIR "${tls_directory}")
      file(READ "${original}" content)
      set(anchor "    if (cfg->client_session != NULL) {\n        ESP_LOGD(TAG, \"Reusing the already saved client session context\");")
      string(FIND "${content}" "${anchor}" found)
      if(found LESS 0)
        message(FATAL_ERROR "ESP-TLS session source changed; review async session polling overlay for this SDK")
      endif()
      set(fixed "    /* Resumption must be configured once before the initial ClientHello. */\n    if (cfg->client_session != NULL &&\n        tls->ssl.MBEDTLS_PRIVATE(state) == MBEDTLS_SSL_HELLO_REQUEST) {\n        ESP_LOGD(TAG, \"Reusing the already saved client session context\");")
      string(REPLACE "${anchor}" "${fixed}" patched "${content}")
      if(CONFIG_MBEDTLS_ECP_RESTARTABLE)
        set(crypto_anchor "        if (ret != ESP_TLS_ERR_SSL_WANT_READ && ret != ESP_TLS_ERR_SSL_WANT_WRITE) {")
        string(FIND "${patched}" "${crypto_anchor}" crypto_found)
        if(crypto_found LESS 0)
          message(FATAL_ERROR "ESP-TLS handshake source changed; review resumable crypto polling overlay")
        endif()
        set(crypto_fixed "#if defined(CONFIG_MBEDTLS_ECP_RESTARTABLE)\n        if (ret == MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS) {\n            /* Preserve the handshake context and let audio/idle run before resuming. */\n            vTaskDelay(1);\n            return 0;\n        }\n#endif\n${crypto_anchor}")
        string(REPLACE "${crypto_anchor}" "${crypto_fixed}" patched "${patched}")
        set(patched "#include <freertos/FreeRTOS.h>\n#include <freertos/task.h>\n${patched}")
      endif()
      set(output "${CMAKE_BINARY_DIR}/lunaros-sdk/esp_tls_mbedtls.c")
      file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/lunaros-sdk")
      file(CONFIGURE OUTPUT "${output}" CONTENT "${patched}" @ONLY)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
      list(APPEND replacement_sources "${output}")
      math(EXPR replaced "${replaced}+1")
    else()
      list(APPEND replacement_sources "${source}")
    endif()
  endforeach()
  if(NOT replaced EQUAL 1)
    message(FATAL_ERROR "Expected exactly one ESP-TLS MbedTLS source for session polling overlay")
  endif()
  set_property(TARGET ${tls_library} PROPERTY SOURCES "${replacement_sources}")
  message(STATUS "LunarOS: ESP-TLS async session setup applied once; installed SDK unchanged")
endfunction()

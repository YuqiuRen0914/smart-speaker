# Keep the pinned vendor component intact. Already-ready samples need no
# inter-poll delay; a not-ready sensor still yields and retains its timeout.
function(lunaros_fix_mpu6050_ready_poll)
  idf_build_get_property(components BUILD_COMPONENTS)
  set(matches)
  foreach(component IN LISTS components)
    if(component MATCHES "(^|__)esp_mpu6050$")
      list(APPEND matches "${component}")
    endif()
  endforeach()
  list(LENGTH matches count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one MPU6050 component for ready polling overlay")
  endif()
  list(GET matches 0 component)
  idf_component_get_property(library ${component} COMPONENT_LIB)
  get_target_property(sources ${library} SOURCES)
  get_target_property(directory ${library} SOURCE_DIR)
  set(replacement_sources)
  set(replaced 0)
  foreach(source IN LISTS sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "mpu6050.c")
      get_filename_component(original "${source}" ABSOLUTE BASE_DIR "${directory}")
      # The vendor source includes "include/mpu6050.h" relative to its own
      # directory. Preserve that lookup when compiling the build-local copy.
      get_filename_component(original_directory "${original}" DIRECTORY)
      set_property(TARGET ${library} APPEND PROPERTY INCLUDE_DIRECTORIES "${original_directory}")
      file(READ "${original}" content)
      set(anchor "        /* delay task before next i2c transaction */\n        vTaskDelay(pdMS_TO_TICKS(MPU6050_DATA_READY_DELAY_MS));\n\n        /* validate timeout condition */")
      string(FIND "${content}" "${anchor}" found)
      if(found LESS 0)
        message(FATAL_ERROR "MPU6050 source changed; review ready polling overlay")
      endif()
      string(LENGTH "${anchor}" anchor_length)
      math(EXPR after "${found}+${anchor_length}")
      string(SUBSTRING "${content}" ${after} -1 tail)
      string(FIND "${tail}" "${anchor}" duplicate)
      if(NOT duplicate LESS 0)
        message(FATAL_ERROR "Ambiguous MPU6050 ready polling overlay")
      endif()
      set(fixed "        /* Yield only between polls; ready data can be read immediately. */\n        if (!data_is_ready) {\n            const TickType_t delay = pdMS_TO_TICKS(MPU6050_DATA_READY_DELAY_MS);\n            vTaskDelay(delay ? delay : 1);\n        }\n\n        /* validate timeout condition */")
      string(REPLACE "${anchor}" "${fixed}" patched "${content}")
      set(output "${CMAKE_BINARY_DIR}/lunaros-vendor/mpu6050.c")
      file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/lunaros-vendor")
      file(CONFIGURE OUTPUT "${output}" CONTENT "${patched}" @ONLY)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
      list(APPEND replacement_sources "${output}")
      math(EXPR replaced "${replaced}+1")
    else()
      list(APPEND replacement_sources "${source}")
    endif()
  endforeach()
  if(NOT replaced EQUAL 1)
    message(FATAL_ERROR "Expected exactly one MPU6050 source for ready polling overlay")
  endif()
  set_property(TARGET ${library} PROPERTY SOURCES "${replacement_sources}")
  message(STATUS "LunarOS: MPU6050 ready reads skip inter-poll wait; vendor source unchanged")
endfunction()

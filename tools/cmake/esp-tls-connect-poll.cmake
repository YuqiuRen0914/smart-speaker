# ESP-IDF 6.1 async TCP connect reuses fd_sets mutated by select(). A timeout
# empties those sets, preventing later polls from observing a completed socket.
# Keep a checked build-local source overlay; never edit the installed SDK.
function(lunaros_fix_esp_tls_connect_poll)
  idf_component_get_property(tls_library esp-tls COMPONENT_LIB)
  get_target_property(tls_sources ${tls_library} SOURCES)
  get_target_property(tls_directory ${tls_library} SOURCE_DIR)
  set(replacement_sources)
  set(replaced 0)
  foreach(source IN LISTS tls_sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "esp_tls.c")
      get_filename_component(original "${source}" ABSOLUTE BASE_DIR "${tls_directory}")
      file(READ "${original}" content)
      set(anchor "    case ESP_TLS_CONNECTING:\n        if (cfg && cfg->non_block) {\n            ESP_LOGD(TAG, \"connecting...\");")
      string(FIND "${content}" "${anchor}" found)
      if(found LESS 0)
        message(FATAL_ERROR "ESP-TLS async connect source changed; review fd-set polling overlay for this SDK")
      endif()
      set(fixed "    case ESP_TLS_CONNECTING:\n        if (cfg && cfg->non_block) {\n            /* select() overwrites its sets even on timeout. Rebuild for each async poll. */\n            FD_ZERO(&tls->rset);\n            FD_SET(tls->sockfd, &tls->rset);\n            tls->wset = tls->rset;\n            ESP_LOGD(TAG, \"connecting...\");")
      string(REPLACE "${anchor}" "${fixed}" patched "${content}")
      set(output "${CMAKE_BINARY_DIR}/lunaros-sdk/esp_tls.c")
      file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/lunaros-sdk")
      file(CONFIGURE OUTPUT "${output}" CONTENT "${patched}" @ONLY)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
      list(APPEND replacement_sources "${output}")
      math(EXPR replaced "${replaced}+1")
    else()
      list(APPEND replacement_sources "${source}")
    endif()
  endforeach()
  if(NOT replaced EQUAL 1)
    message(FATAL_ERROR "Expected exactly one ESP-TLS source for async connect overlay")
  endif()
  set_property(TARGET ${tls_library} PROPERTY SOURCES "${replacement_sources}")
  message(STATUS "LunarOS: ESP-TLS async socket polling overlay applied; installed SDK unchanged")
endfunction()

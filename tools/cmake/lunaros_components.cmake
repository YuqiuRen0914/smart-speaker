# Apps and Services each have required/ and optional/ build boundaries.
# Required Services are auto-selected; system Apps are explicitly selected by
# LUNAREDU_SYSTEM_APPS. Compilation does not imply boot activation.
function(lunaros_collect_builtin_components repo_root group prefix output_variable)
  if(CMAKE_SCRIPT_MODE_FILE)
    file(GLOB markers "${repo_root}/lunaros/${group}/required/*/CMakeLists.txt")
  else()
    file(GLOB markers CONFIGURE_DEPENDS "${repo_root}/lunaros/${group}/required/*/CMakeLists.txt")
  endif()
  set(services "")
  foreach(marker IN LISTS markers)
    get_filename_component(directory "${marker}" DIRECTORY)
    get_filename_component(name "${directory}" NAME)
    if(NOT name MATCHES "^${prefix}_[a-z0-9][a-z0-9_]*$")
      message(FATAL_ERROR "Invalid built-in LunarOS ${group} directory: ${directory}")
    endif()
    list(APPEND services "${name}")
  endforeach()
  list(SORT services)
  set(${output_variable} "${services}" PARENT_SCOPE)
endfunction()

function(lunaros_collect_builtin_services repo_root output_variable)
  lunaros_collect_builtin_components("${repo_root}" services service services)
  set(${output_variable} "${services}" PARENT_SCOPE)
endfunction()

function(lunaros_collect_builtin_apps repo_root output_variable)
  lunaros_collect_builtin_components("${repo_root}" apps app apps)
  foreach(app IN LISTS LUNAREDU_SYSTEM_APPS)
    if(NOT app IN_LIST apps)
      message(FATAL_ERROR "Unknown system App selection: ${app}")
    endif()
  endforeach()
  set(${output_variable} "${LUNAREDU_SYSTEM_APPS}" PARENT_SCOPE)
endfunction()

# Called after IDF has prepared its roots, before dependency expansion.
macro(lunaros_append_builtin_app_roots roots)
  foreach(app IN LISTS lunaredu_builtin_apps)
    if(app IN_LIST EXCLUDE_COMPONENTS)
      message(FATAL_ERROR "Selected LunarOS App cannot be excluded: ${app}")
    endif()
  endforeach()
  list(APPEND ${roots} ${lunaredu_builtin_apps})
  list(APPEND ${roots} ${lunaredu_default_optional_services})
  list(REMOVE_DUPLICATES ${roots})
endmacro()

set(vendor_directory "${CMAKE_CURRENT_LIST_DIR}/upstream")
if(LUNAREDU_LVGL_SOURCE_DIR)
  get_filename_component(vendor_directory "${LUNAREDU_LVGL_SOURCE_DIR}" ABSOLUTE)
endif()
set(vendor_manifest "${CMAKE_CURRENT_LIST_DIR}/upstream.sha256")
set(vendor_manifest_hash "0f5ab597e2a0e910b76db28e684a4f2caf12103f2a28d10939ed50e5efed9d82")
include("${CMAKE_CURRENT_LIST_DIR}/../../tools/cmake/verify-vendor.cmake")
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/UPSTREAM.json" provenance_hash)
if(NOT provenance_hash STREQUAL "7a56ceed3381bcf763840199d23407247df3e2067b9229a473a30808756c85ef")
  message(FATAL_ERROR "Changed lvgl vendor provenance")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/UPSTREAM.json" metadata)
string(JSON revision GET "${metadata}" revision)
string(JSON expected_count GET "${metadata}" file_count)
list(LENGTH vendor_expected actual_count)
if(NOT revision STREQUAL "80ca777e37a2b176770726a02e07a6fb79ef0b39" OR NOT expected_count EQUAL actual_count)
  message(FATAL_ERROR "Unexpected lvgl vendor provenance")
endif()

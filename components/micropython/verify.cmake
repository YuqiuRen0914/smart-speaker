set(micropython_material "${CMAKE_CURRENT_LIST_DIR}")
if(DEFINED LUNAREDU_MICROPYTHON_MATERIAL_DIR AND NOT "${LUNAREDU_MICROPYTHON_MATERIAL_DIR}" STREQUAL "")
  set(micropython_material "${LUNAREDU_MICROPYTHON_MATERIAL_DIR}")
endif()
set(vendor_directory "${micropython_material}/upstream")
set(vendor_manifest "${micropython_material}/upstream.sha256")
set(vendor_manifest_hash "dc470cc0bb9c6924422f226d0df890d32969334634e3a1764a7f0c17ff0a7f87")
include("${CMAKE_CURRENT_LIST_DIR}/../../tools/cmake/verify-vendor.cmake")
file(READ "${micropython_material}/UPSTREAM.json" metadata)
file(SHA256 "${micropython_material}/UPSTREAM.json" provenance_hash)
if(NOT provenance_hash STREQUAL "2f67ed32449336cc08f81e2d294e16a8906f2238372bc36f1b3aa5c8799830ee")
  message(FATAL_ERROR "Changed micropython vendor provenance")
endif()
string(JSON revision GET "${metadata}" revision)
string(JSON manifest_hash GET "${metadata}" manifest_sha256)
string(JSON expected_count GET "${metadata}" file_count)
list(LENGTH vendor_expected actual_count)
if(NOT revision STREQUAL "0fd6c573ea815774668bbb16b8e197c8822368b2" OR NOT manifest_hash STREQUAL "dc470cc0bb9c6924422f226d0df890d32969334634e3a1764a7f0c17ff0a7f87" OR NOT expected_count EQUAL actual_count)
  message(FATAL_ERROR "Unexpected micropython vendor provenance")
endif()
set(vendor_directory "${micropython_material}/generated/embed")
set(vendor_manifest "${micropython_material}/generated.sha256")
set(vendor_manifest_hash "bf5fb77e82d610768e8230f0608c36ce24175ed2824a18159d8b2b38b017a35b")
include("${CMAKE_CURRENT_LIST_DIR}/../../tools/cmake/verify-vendor.cmake")
string(JSON generated_hash GET "${metadata}" generated_manifest_sha256)
if(NOT generated_hash STREQUAL vendor_manifest_hash)
  message(FATAL_ERROR "Unexpected MicroPython generated provenance")
endif()
file(READ "${micropython_material}/GENERATION.json" generation)
string(JSON generation_revision GET "${generation}" upstream_revision)
string(JSON generation_hash GET "${generation}" generated_manifest_sha256)
if(NOT generation_revision STREQUAL revision OR NOT generation_hash STREQUAL generated_hash)
  message(FATAL_ERROR "Unexpected MicroPython generation provenance")
endif()
file(SHA256 "${micropython_material}/tools/mpconfigport.h" actual_input_hash)
string(JSON recorded_input_hash GET "${generation}" inputs "tools/mpconfigport.h")
if(NOT actual_input_hash STREQUAL "c1eccb65edb65ba83682b2a9efbd71a1d5d76d27b9f0ba7a41f18836f1fb8dad" OR NOT recorded_input_hash STREQUAL "c1eccb65edb65ba83682b2a9efbd71a1d5d76d27b9f0ba7a41f18836f1fb8dad")
  message(FATAL_ERROR "Changed MicroPython generation input: tools/mpconfigport.h")
endif()
file(SHA256 "${micropython_material}/tools/generate-embed.py" actual_input_hash)
string(JSON recorded_input_hash GET "${generation}" inputs "tools/generate-embed.py")
if(NOT actual_input_hash STREQUAL "d107d7de60448c10402d95937254dbc88c806861eccc2339836e884dc86d7de6" OR NOT recorded_input_hash STREQUAL "d107d7de60448c10402d95937254dbc88c806861eccc2339836e884dc86d7de6")
  message(FATAL_ERROR "Changed MicroPython generation input: tools/generate-embed.py")
endif()
file(SHA256 "${micropython_material}/patches/embed-includes.patch" actual_input_hash)
string(JSON recorded_input_hash GET "${generation}" inputs "patches/embed-includes.patch")
if(NOT actual_input_hash STREQUAL "a86d6a17b543fbe7d79c3c523b55f78864a9993858ddeecb9b2b7007a758c634" OR NOT recorded_input_hash STREQUAL "a86d6a17b543fbe7d79c3c523b55f78864a9993858ddeecb9b2b7007a758c634")
  message(FATAL_ERROR "Changed MicroPython generation input: patches/embed-includes.patch")
endif()

set(vendor_directory "${CMAKE_CURRENT_LIST_DIR}/upstream")
set(vendor_manifest "${CMAKE_CURRENT_LIST_DIR}/upstream.sha256")
set(vendor_manifest_hash "279002bda8af314a31612d1a7893f49b6d6f3cf646000d9958d3297f47fb09f6")
include("${CMAKE_CURRENT_LIST_DIR}/../../../../tools/cmake/verify-vendor.cmake")
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/UPSTREAM.json" provenance_hash)
if(NOT provenance_hash STREQUAL "641c3a84b734fe88e93b1c5913f8a115c80ffbfd1697c35adec0f022d1978c21")
  message(FATAL_ERROR "Changed qrcodegen vendor provenance")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/UPSTREAM.json" metadata)
string(JSON revision GET "${metadata}" revision)
string(JSON expected_count GET "${metadata}" file_count)
list(LENGTH vendor_expected actual_count)
if(NOT revision STREQUAL "3c6d0b3cefb4e049dc337e82237c9644399716a8" OR NOT expected_count EQUAL actual_count)
  message(FATAL_ERROR "Unexpected qrcodegen vendor provenance")
endif()

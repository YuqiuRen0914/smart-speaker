set(vendor_directory "${CMAKE_CURRENT_LIST_DIR}/upstream")
if(LUNAREDU_WAMR_SOURCE_DIR)
  get_filename_component(vendor_directory "${LUNAREDU_WAMR_SOURCE_DIR}" ABSOLUTE)
endif()
set(vendor_manifest "${CMAKE_CURRENT_LIST_DIR}/upstream.sha256")
set(vendor_manifest_hash "a1930b03a9a8611453829c29de0ee7c10336e834db9682a7cd82a61deeabdca5")
include("${CMAKE_CURRENT_LIST_DIR}/../../tools/cmake/verify-vendor.cmake")
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/UPSTREAM.json" provenance_hash)
if(NOT provenance_hash STREQUAL "ae12f379e10a8e2d4489b546d89e2a0e07d89c515d6c6f67ddd327e5abf0eff1")
  message(FATAL_ERROR "Changed wamr vendor provenance")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/UPSTREAM.json" metadata)
string(JSON revision GET "${metadata}" revision)
string(JSON expected_count GET "${metadata}" file_count)
list(LENGTH vendor_expected actual_count)
if(NOT revision STREQUAL "0982ec5e5ecb4ad17061d6538875417727c8b1ea" OR NOT expected_count EQUAL actual_count)
  message(FATAL_ERROR "Unexpected wamr vendor provenance")
endif()

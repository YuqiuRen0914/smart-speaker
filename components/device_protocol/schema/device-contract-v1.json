{
  "protocol": "lunaredu.wire",
  "revision": 4,
  "messages": [
    "session.open",
    "session.opened",
    "session.close",
    "session.closed",
    "capability.list",
    "capability.describe",
    "capability.result",
    "activity.submit",
    "activity.accepted",
    "activity.progress",
    "activity.completed",
    "activity.failed",
    "activity.rejected",
    "activity.cancel",
    "activity.canceled",
    "media.open",
    "media.opened",
    "media.chunk",
    "media.close",
    "media.closed",
    "event.emit",
    "protocol.error",
    "operation.invoke",
    "operation.result"
  ],
  "lp": {
    "version": 1,
    "magic": [
      76,
      80
    ],
    "header_bytes": 10,
    "crc_bytes": 4,
    "max_payload_bytes": 2048,
    "types": {
      "get_info": 1,
      "open_session": 2,
      "confirm_session": 3,
      "set_wifi": 4,
      "get_status": 5,
      "close_session": 6,
      "get_binding": 7,
      "factory_status": 16,
      "factory_start": 17,
      "factory_confirm": 18,
      "factory_reset": 19,
      "factory_unit_id": 20,
      "device_command": 32,
      "error": 127
    },
    "response_flag": 128,
    "course_types": {
      "status": 32,
      "command": 33,
      "diagnostics": 34
    }
  },
  "profiles": {
    "management": {
      "encoding": "lp+json",
      "authorization": "confirmed-local-channel",
      "operation": "module_id+operation_id+request",
      "result": "ok+result+error.code",
      "fragments": {
        "fields": [
          "part",
          "total",
          "hex"
        ],
        "max_parts": 256,
        "max_part_bytes": 512,
        "max_response_bytes": 18432,
        "index_base": 0,
        "encoding": "utf8-bytes-as-lowercase-hex",
        "duplicate": "identical-only",
        "timeout_ms": 10000
      },
      "local_operations": [
        "usb.operations.get",
        "usb.info.get",
        "usb.status.get",
        "diagnostics.session.open",
        "diagnostics.session.close"
      ],
      "local_authority": {
        "debug_token": "physical-diagnostic-session-only"
      },
      "family": "device",
      "profile": "management"
    },
    "remote_control": {
      "encoding": "lp+binary",
      "source": "../../remote-control/v2/wire.json",
      "authorization": "peer+binding_nonce",
      "delivery": "latest-only",
      "protocol": "lunaredu.wire",
      "radio_transport": "espressif-espnow-data-v2",
      "radio_frame": "official-espnow-DATA-with-LP-payload",
      "family": "device",
      "profile": "remote_control"
    },
    "operation": {
      "encoding": "json",
      "authorization": "authenticated-channel+binding_epoch",
      "delivery": [
        "durable",
        "realtime"
      ],
      "maximum_request_bytes": 2048,
      "maximum_sequence_install_request_bytes": 14336,
      "maximum_result_bytes": 8192,
      "maximum_batch_size": 10,
      "maximum_realtime_bytes": 1536,
      "maximum_realtime_result_bytes": 3900,
      "recent_request_count": 64,
      "family": "device",
      "profile": "operation"
    },
    "activity": {
      "encoding": "json",
      "delivery": "terminal-feedback",
      "family": "device",
      "profile": "activity"
    },
    "media": {
      "encoding": "negotiated",
      "delivery": "sequenced-bounded-stream",
      "family": "device",
      "profile": "media"
    },
    "course_onboard": {
      "encoding": "lp+json",
      "selection": "GetInfo.capabilities contains course_onboard_usb_v1",
      "authorization": "physical-usb+device-serial",
      "types": "lp.course_types",
      "owner": "course-board firmware; not LunarOS DeviceCommand",
      "family": "device",
      "profile": "course_onboard"
    },
    "serial_stream": {
      "encoding": "binary",
      "protocol": "lunaredu.wire",
      "version": 1,
      "magic": [
        76,
        83
      ],
      "header_bytes": 24,
      "max_payload_bytes": 4096,
      "max_tx_bytes": 1024,
      "byte_order": "little",
      "fields": {
        "version": 2,
        "flags": 3,
        "generation": 4,
        "cursor": 8,
        "lost": 16
      },
      "cursor_encoding": "decimal-u64-string",
      "read_type": "serial.read",
      "ack_type": "serial.write.result",
      "authorization": "device-grant+control-lease",
      "family": "device",
      "profile": "serial_stream"
    },
    "media_udp": {
      "encoding": "binary",
      "version": 2,
      "header_bytes": 16,
      "tag_bytes": 16,
      "max_payload_bytes": 1468,
      "byte_order": "big",
      "encryption": "aes-128-gcm",
      "fields": {
        "version": 0,
        "direction": 1,
        "payload_bytes": 2,
        "connection_id": 4,
        "timestamp_ms": 8,
        "sequence": 12
      },
      "directions": {
        "device_to_platform": 0,
        "platform_to_device": 1
      },
      "nonce": "connection_id_be32+000000+direction_u8+sequence_be32",
      "aad": "complete-header",
      "sequence": "nonzero-u32-no-wrap",
      "family": "device",
      "profile": "media_udp"
    },
    "authorization": {
      "encoding": "pipe-separated-utf8",
      "algorithm": "hmac-sha256",
      "key": "sha256-device-credential-as-32-raw-bytes",
      "time_unit": "unix-seconds",
      "purposes": {
        "owner": {
          "prefix": "llo1",
          "fields": [
            "serial",
            "binding_epoch",
            "access_epoch",
            "actor",
            "expires",
            "audience"
          ],
          "ttl_seconds": 120,
          "clock_skew_seconds": 60
        },
        "shared": {
          "prefix": "lls1",
          "fields": [
            "serial",
            "binding_epoch",
            "access_epoch",
            "actor",
            "expires",
            "audience"
          ],
          "ttl_seconds": 5,
          "clock_skew_seconds": 0
        },
        "admin": {
          "prefix": "lla1",
          "fields": [
            "serial",
            "binding_epoch",
            "expires",
            "audience"
          ],
          "ttl_seconds": 120,
          "clock_skew_seconds": 60
        },
        "admin_request": {
          "prefix": "llr1",
          "fields": [
            "serial",
            "binding_epoch",
            "expires",
            "state",
            "callback_origin",
            "audience"
          ],
          "ttl_seconds": 600
        }
      },
      "grant_omits_serial": true,
      "signature_encoding": "lowercase-hex",
      "maximum_grant_bytes": 256,
      "clock_skew_seconds": 60,
      "provisioning_proof": {
        "prefix": "LP/1:device:",
        "key_encoding": "qr-proof-hex-as-ASCII",
        "claims": [
          "serial",
          "nonce"
        ],
        "nonce": "nonzero-u32-decimal",
        "maximum_session_ms": 300000
      },
      "family": "device",
      "profile": "authorization"
    },
    "mqtt": {
      "encoding": "json",
      "voice_up": "lunarlink/{device_id}/up",
      "voice_down": "lunarlink/{device_id}/down",
      "control_down": "lunaredu/hardware/v2/devices/{serial}/commands/teleop",
      "control_up": "lunaredu/hardware/v2/devices/{serial}/command-results",
      "identity": "authenticated-topic-owner",
      "retained": false,
      "family": "device",
      "profile": "mqtt"
    },
    "local_http": {
      "encoding": "http+json",
      "operation_path": "/api/v1/modules/{module_id}/{operation_id}",
      "result": "ok+result+error.code",
      "api_version": 1,
      "bulk": "raw-stream-with-domain-metadata",
      "authorization": "device-grant+operation-policy",
      "family": "device",
      "profile": "local_http"
    },
    "provisioning": {
      "encoding": "lp+base64-protobuf",
      "protocol": "network-provisioning-security1",
      "security_version": 1,
      "session_endpoint": "prov-session",
      "config_endpoint": "prov-config",
      "authorization": "confirmed-local-channel+nonce+proof-of-possession",
      "credential_owner": "existing-network-executor",
      "plaintext_credentials": false
    }
  },
  "builtins": {
    "status_refresh": {
      "module_id": "platform_runtime",
      "operation_id": "status.get"
    },
    "clock_sync": {
      "module_id": "platform_runtime",
      "operation_id": "clock.sync"
    },
    "led_set": {
      "module_id": "platform_runtime",
      "operation_id": "led.set"
    },
    "reboot": {
      "module_id": "platform_runtime",
      "operation_id": "restart"
    },
    "mode_set": {
      "module_id": "platform_runtime",
      "operation_id": "application.switch"
    }
  },
  "builtin_module": "platform_runtime",
  "domains": {
    "claw": "../../../lunaros/services/optional/service_claw/protocol/operations.json"
  },
  "family": "device",
  "version": 1,
  "message_profiles": {
    "session.open": "activity",
    "session.opened": "activity",
    "session.close": "activity",
    "session.closed": "activity",
    "capability.list": "activity",
    "capability.describe": "activity",
    "capability.result": "activity",
    "activity.submit": "activity",
    "activity.accepted": "activity",
    "activity.progress": "activity",
    "activity.completed": "activity",
    "activity.failed": "activity",
    "activity.rejected": "activity",
    "activity.cancel": "activity",
    "activity.canceled": "activity",
    "media.open": "media",
    "media.opened": "media",
    "media.chunk": "media",
    "media.close": "media",
    "media.closed": "media",
    "event.emit": "activity",
    "protocol.error": "activity",
    "operation.invoke": "operation",
    "operation.result": "operation"
  }
}
